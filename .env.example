# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Publishing to PyPI (maintainers only) ---
# uv publish reads this automatically.
UV_PUBLISH_TOKEN=pypi-REPLACE_WITH_YOUR_TOKEN

# --- LLM engine (optional; activates the LLM-backed extraction path) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# --- OCI registry / Locus Hub (optional) ---
# LOCUS_REGISTRY=hub.your-domain.com
# LOCUS_NAMESPACE=library
# LOCUS_INSECURE=0
